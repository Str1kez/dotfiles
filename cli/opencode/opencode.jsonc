{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{file:./.context7.key}"
      }
    }
  },
  "plugin": [],
  "provider": {
    "zai": {
      "options": {
        "baseURL": "http://127.0.0.1:17321",
        "headers": {
          "sleev-harness": "opencode",
          "sleev-base-url": "https://api.z.ai/api/paas/v4"
        }
      }
    },
    "opencode": {
      "options": {
        "baseURL": "http://127.0.0.1:17321",
        "headers": {
          "sleev-provider": "opencode",
          "sleev-harness": "opencode"
        }
      }
    }
  },
  // убрать без sleev
  "compaction": {
    "prune": false
  }
}
